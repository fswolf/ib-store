RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?store.imbored.me [NC]
RewriteRule \.(jpg|jpeg|png|gif)$ - [NC,F,L]

RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/ [R=301,L]

# Deny access to filenames starting with dot(.) .htaccess, .htpasswd, .env
<FilesMatch "^\.">
	Order allow,deny
	Deny from all
</FilesMatch>

# Deny access to files with extensions .ini, .psd, .log, .sh
<FilesMatch "\.(ini|psd|log|sh)$">
	Order allow,deny
	Deny from all
</FilesMatch>

# Stylesheet and scripts: the browser keeps its copy but asks the server each time whether it changed.
# Apache answers 304 (a few bytes) when it did not, so a deploy shows up on the next page load instead of
# whenever the browser feels like it. Images keep the default caching.
<IfModule mod_headers.c>
	<FilesMatch "\.(css|js)$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
</IfModule>

# Hide the contents of directories
IndexIgnore *

# Disable directory browsing 
Options -Indexes

#Redirect Forbbiden Errors to 404 page
ErrorDocument 403 /404